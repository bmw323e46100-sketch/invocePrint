# Rust target directory — генерируется cargo, не нужна в git
/target/

# Cargo.lock — для бинарников оставляем, для библиотек убираем.
# Это приложение (бинарник), поэтому Cargo.lock ДОЛЖЕН быть в git.
# Раскомментируйте строку ниже, если решите убрать Cargo.lock:
# Cargo.lock

# Сгенерированные PDF — не должны быть в репозитории
*.pdf
/sample_output.pdf

# Шрифты скачиваются автоматически build.rs при первой сборке.
# Поэтому их НЕ нужно хранить в git — они весят ~700 КБ
# и могут вызывать артефакты при слиянии веток.
/assets/fonts/*.ttf

# Файлы черновика (если случайно оказался рядом с исходниками)
/zayavka_draft.json
/zayavka_data/

# Идеи и временные файлы редакторов
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Логи и временные файлы
*.log
*.tmp
